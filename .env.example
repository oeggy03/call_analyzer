# The app does not read this file. Export any variable you need in the shell.
# Placeholders only. Do not put a real key in git.

# Wins over the macOS Keychain entry. Leave unset to use Keychain.
# OPENROUTER_API_KEY=replace-with-openrouter-key

# Absolute path to the ScreenCaptureKit helper. Optional after scripts/build-macos-capture.sh.
# CALL_ANALYZER_CAPTURE_HELPER=/absolute/path/to/call-analyzer-capture

# Alternate helper path. CALL_ANALYZER_CAPTURE_HELPER takes precedence.
# CALL_ANALYZER_CAPTURE_BIN=/absolute/path/to/call-analyzer-capture

# Wails CLI. Defaults to $(go env GOPATH)/bin/wails.
# WAILS_BIN=/absolute/path/to/wails

# codesign identity for scripts/build-macos-app.sh. "-" is ad-hoc.
# APPLE_SIGNING_IDENTITY=-
